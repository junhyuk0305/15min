# 그래고 환경변수 예시. 실제 값은 .env에 넣는다(.env는 git에 올리지 않는다).

# ── 앱 번들에 들어가는 값 (EXPO_PUBLIC_ 접두사만 앱에 노출된다) ──
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# 비워 두면 오류 수집을 끄고 콘솔에만 남긴다
EXPO_PUBLIC_SENTRY_DSN=

# ── 서버 전용 값 (npx supabase secrets set 으로 넣는다. 앱에 넣지 않는다) ──
GEMINI_API_KEY=<gemini-api-key>
# 대화와 목표 설정용 모델, 채점과 항목 추출용 모델
AI_MODEL_MAIN=
AI_MODEL_LIGHT=
# 사용자당 하루 AI 호출 상한, 목표 설정은 목표당 상한
AI_DAILY_LIMIT=150
AI_GOAL_SETUP_LIMIT=30
# 계정 삭제 시 이메일 해시에 섞는 값
EMAIL_HASH_SALT=<random-string>
# 1이면 Gemini를 부르지 않고 고정 응답을 돌려준다. 로컬 테스트 전용. 프로덕션에 넣지 않는다
AI_FAKE=0
# 심사용 데모 계정 이메일. 이 이메일일 때만 앱에 비밀번호 로그인 입력이 보인다. 시드 스크립트가 서버 설정 표에 넣는다
REVIEW_EMAIL=

# ── 로컬 도구용 (CI, 평가 스크립트) ──
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_ACCESS_TOKEN=<personal-access-token>
